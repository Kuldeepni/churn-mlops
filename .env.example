# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. `.env` itself is git-ignored and must never be committed.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_JSON=true

# Where the serving bundle (pipeline + threshold + metadata) is loaded from.
MODEL_DIR=models

# Where prediction logs (JSONL) are appended.
PREDICTION_LOG=logs/predictions.jsonl

# Maximum number of customers accepted in a single /predict request.
MAX_BATCH_SIZE=100

# Comma separated list of allowed browser origins ("" disables CORS).
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# --- MLflow (training pipeline only; the API does not depend on MLflow) ----
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_EXPERIMENT=churn-classifier
